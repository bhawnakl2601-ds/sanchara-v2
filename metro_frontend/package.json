{
  "name": "sanchara-metro-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "python3 -I scripts/extract.py <gtfs_dir> <stations.kml> <codes.csv> src/data/metro.json",
    "test": "tsx scripts/test-engine.ts && tsx scripts/test-restrictions.ts && tsx scripts/test-transition.ts",
    "test:backend": "cd .. && PYTHONPATH=. python3 -m pytest metro_backend/tests",
    "start": "vite"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.8"
  }
}