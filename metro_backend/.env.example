# Copy to metro_backend/.env (loaded automatically). Leave live-feed values EMPTY unless you are authorised:
# empty means the source is reported AUTH_REQUIRED / unavailable. Nothing is invented.
SANCHARA_ENV=dev                 # dev seeds admin@sanchara.local / sanchara-admin-dev; use production for real deployments
DATABASE_URL=sqlite:///metro_backend/metro.db
JWT_SECRET=change-me-long-random-string
JWT_TTL_SEC=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Delay display levels (minutes) - SANCHARA display levels, not BMRCL's
DELAY_MINOR_MIN=3
DELAY_MODERATE_MIN=6
DELAY_MAJOR_MIN=11
NOTIFY_COOLDOWN_SEC=900
REPORT_RATE_LIMIT_PER_HOUR=5
MAX_UPLOAD_BYTES=2097152
UPLOAD_DIR=metro_backend/uploads
SOURCE_STALE_AFTER_SEC=3600
# Live integrations (all optional)
BMRCL_GTFS_RT_ALERTS_URL=
BMRCL_GTFS_RT_TRIPS_URL=
BMRCL_GTFS_RT_VEHICLES_URL=
BMRCL_API_KEY=
BMRCL_API_KEY_HEADER=
BMTC_API_URL=
BMTC_API_KEY=
BMTC_API_KEY_HEADER=
OPENCITY_URL=
FIREBASE_CREDENTIALS_JSON=
FCM_SERVER_KEY=
